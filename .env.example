# =====================================================================
# Colombo Associates — Production Environment Configuration
# =====================================================================

# Server Port (Default: 3000, or assigned by cloud host e.g. Render/Railway)
PORT=3000

# Resend API Key (Sign up at https://resend.com and create an API Key)
# Example: RESEND_API_KEY=re_123456789abcdef
RESEND_API_KEY=

# Sender Email Address (Authorized domain address in Resend)
# Once domain 'colomboassociates.lk' is verified in Resend, use:
# FROM_EMAIL=Colombo Associates <intake@colomboassociates.lk>
# During initial sandbox testing, use:
FROM_EMAIL=Colombo Associates <onboarding@resend.dev>

# Client Matter Enquiries Recipient (Default: enquiries@colomboassociates.lk)
FIRM_INTAKE_EMAIL=enquiries@colomboassociates.lk

# Recruitment Applications Recipient (Default: careers@colomboassociates.lk)
FIRM_CAREERS_EMAIL=careers@colomboassociates.lk
